{
    "name": "uoft-ai",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.22.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint": "oxlint",
        "prettier:check": "prettier --check .",
        "prettier:write": "prettier --write .",
        "prepare": "husky"
    },
    "dependencies": {
        "@chakra-ui/icons": "^2.2.4",
        "@chakra-ui/react": "^2.10.10",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "framer-motion": "^14.3.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-icons": "^5.7.0",
        "react-router": "^8.4.0",
        "typewriter-effect": "^2.22.0"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "oxlint": "^1.88.0",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "vite": "^8.3.4"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "oxlint"
        ],
        "*.{js,jsx,ts,tsx,json,css,scss,md,html}": [
            "prettier --write"
        ]
